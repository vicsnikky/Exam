# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE (PostgreSQL - e.g. Neon, Supabase, Render, Railway, or Cloud SQL)
SQL_HOST="ep-example.eu-west-2.aws.neon.tech"
SQL_USER="postgres"
SQL_PASSWORD="your-secure-password"
SQL_DB_NAME="federal_school_db"

# AUTHENTICATION
JWT_SECRET="federal-international-school-secret-jwt-key-2026"

