# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE API CREDENTIALS
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key-here"
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key-here"

# DATABASE (Supabase PostgreSQL)
# Option A: Single Connection String (Recommended for Supabase)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Option B: Individual Connection Parameters (Alternative)
SQL_HOST="db.[YOUR-PROJECT-REF].supabase.co"
SQL_USER="postgres"
SQL_PASSWORD="your-supabase-db-password"
SQL_DB_NAME="postgres"
SQL_PORT="5432"

# AUTHENTICATION
JWT_SECRET="fenster-international-school-secret-jwt-key-2026"

